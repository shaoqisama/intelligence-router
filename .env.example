# Optional service protection. When set, clients must send Authorization: Bearer <value>.
IR_API_KEY=

# Native provider keys. Models without their key are automatically excluded.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Runtime configuration.
IR_CONFIG_PATH=config/models.yaml
IR_DB_PATH=.data/router.db
IR_DEFAULT_MAX_COST_USD=0.05
IR_DEFAULT_MAX_OUTPUT_TOKENS=800
IR_CACHE_TTL_SEC=900
IR_SESSION_TTL_SEC=3600
IR_REQUEST_TIMEOUT_SEC=60
IR_MAX_RETRIES=0
IR_CACHE_ENABLED=true
IR_LOG_RAW_PROMPTS=false
LOCAL_OPENAI_BASE_URL=
